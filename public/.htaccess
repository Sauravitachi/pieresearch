# Apache config for the static export (Hostinger shared hosting).
# Next.js is built with `trailingSlash: true`, so every route is a folder
# containing index.html and Apache resolves it with no rewrite rules.

DirectoryIndex index.html
ErrorDocument 404 /404.html

# Serve /about for /about/ without a redirect loop, and strip .html if typed.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # /path -> /path/ so relative asset URLs resolve.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

  # /path.html -> /path/
  RewriteCond %{THE_REQUEST} \s/+(.+)\.html[\s?] [NC]
  RewriteRule ^ /%1/ [R=301,L]
</IfModule>

# Immutable hashed build assets.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  <FilesMatch "\.(js|css|woff2|svg|png|jpg|jpeg|webp|avif|ico)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>
